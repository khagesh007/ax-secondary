{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "asseco-voice/laravel-custom-fields": "^2.1",
        "bacon/bacon-qr-code": "^2.0",
        "barryvdh/laravel-dompdf": "^2.0",
        "brick/phonenumber": "^0.5.0",
        "cjmellor/approval": "^1.1",
        "ddeboer/imap": "^1.14",
        "docusign/esign-laravel": "^1.1",
        "fruitcake/laravel-cors": "^2.0",
        "giggsey/libphonenumber-for-php": "^8.13",
        "google/apiclient": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "html2text/html2text": "^4.3",
        "intervention/image": "^2.7",
        "irazasyed/telegram-bot-sdk": "^3.9",
        "lab404/laravel-impersonate": "^1.7",
        "laravel/framework": "^9.00",
        "laravel/sanctum": "^2.11",
        "laravel/socialite": "^5.9",
        "laravel/telescope": "^4.9",
        "laravel/tinker": "^2.5",
        "laravel/ui": "^3.4",
        "league/flysystem-aws-s3-v3": "^3.0",
        "maatwebsite/excel": "^3.1",
        "marvinlabs/laravel-discord-logger": "^1.4",
        "mpdf/mpdf": "^8.2",
        "pragmarx/google2fa-laravel": "^2.1",
        "predis/predis": "^2.2",
        "psr/simple-cache": "2.0",
        "pusher/pusher-php-server": "^7.2",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.5",
        "setasign/fpdi_pdf-parser": "2.1.1",
        "spatie/array-to-xml": "^3.1",
        "spatie/eloquent-sortable": "^4.0",
        "spatie/laravel-activitylog": "^4.6",
        "spatie/laravel-google-calendar": "^3.5",
        "spatie/laravel-permission": "^5.5",
        "spatie/laravel-searchable": "^1.11",
        "studio/laravel-totem": "^10.0",
        "webklex/laravel-imap": "^4.0",
        "yajra/laravel-datatables-oracle": "^9.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.7",
        "fakerphp/faker": "^1.9.1",
        "knuckleswtf/scribe": "^4.19",
        "laravel/sail": "^1.0.1",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.0",
        "phpunit/phpunit": "^9.5.10",
        "spatie/laravel-ignition": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://www.setasign.com/downloads/"
        }
    ],
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true

}
